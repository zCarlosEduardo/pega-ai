# Porta do servidor (Render/Railway/Fly definem sozinhos via PORT)
PORT=8787

# Segredo da URL do cron (use algo aleatório e longo)
CRON_SECRET=troque-isto-por-um-token-aleatorio

# VAPID (gere com:  npx web-push generate-vapid-keys)
VAPID_PUBLIC=...
VAPID_PRIVATE=...
VAPID_SUBJECT=mailto:voce@exemplo.com

# Service account do Firebase (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@seu-projeto.iam.gserviceaccount.com
# cole a private key inteira numa linha, com os \n literais (entre aspas)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Fuso pros horários de remédio e contagem de datas
TZ_NAME=America/Sao_Paulo

# Horas (no fuso acima) a partir das quais cada aviso pode sair
DATE_HOUR=9     # lembretes de data (nunca à meia-noite)
DAILY_HOUR=8    # resumo diário (janela de 4 horas)
