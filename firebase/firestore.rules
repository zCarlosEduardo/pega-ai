rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(spaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(uid()));
    }
    function isAdmin(spaceId) {
      return isMember(spaceId)
        && get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(uid())).data.role == 'admin';
    }

    // ponteiro do usuário -> espaços
    // schema: { spaceId (legado), spaceIds: [..], activeSpaceId }
    match /users/{userId} {
      allow read, write: if signedIn() && userId == uid();
    }

    // convites: lookup/preview por código. Qualquer autenticado lê (precisa pra entrar).
    // O código é aleatório (PEGA-XXXX), então não dá pra "varrer" espaços.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();   // permite admin re-gerar/atualizar nome
      allow delete: if signedIn();   // permite cleanup ao deletar espaço (futuro)
    }

    match /spaces/{spaceId} {
      allow read:   if isMember(spaceId);
      allow create: if signedIn();              // ao criar, o batch também cria o seu member
      allow update: if isMember(spaceId);
      allow delete: if false;

      // membros: você cria/edita o seu próprio doc.
      // delete: você mesmo OU admin do espaço (pra "remover pessoa").
      match /members/{memberId} {
        allow read:                if isMember(spaceId);
        allow create, update:      if signedIn() && memberId == uid();
        allow delete:              if signedIn() && (memberId == uid() || isAdmin(spaceId));
      }

      // dados do espaço: só membros
      match /lists/{listId}      { allow read, write: if isMember(spaceId); }
      match /listItems/{itemId}  { allow read, write: if isMember(spaceId); }
      match /dates/{dateId}      { allow read, write: if isMember(spaceId); }
      match /meds/{medId}        { allow read, write: if isMember(spaceId); }
      match /achievements/{aId}  { allow read, write: if isMember(spaceId); }
      match /activity/{actId}    { allow read, write: if isMember(spaceId); }
      match /pushSubs/{subUid}   {
        allow read:  if isMember(spaceId);
        allow write: if signedIn() && subUid == uid();
      }
    }
  }
}
